# ============================================================
# متغیرهای محیطی سامانه مدیریت تاسیسات هتل
# ============================================================

# 1. آدرس دیتابیس (DATABASE_URL)
# در محیط sandbox: SQLite محلی
# در محیط production: Turso (libSQL)

# حالت sandbox محلی:
DATABASE_URL="file:/home/z/my-project/db/custom.db"

# حالت production با Turso:
# این مقادیر رو از dashboard.turso.app بگیرید
# DATABASE_URL="libsql://your-db-name-your-username.turso.io"
# TURSO_TOKEN="eyJhbGciOi..." (توکن دسترسی Turso)

# 2. کلید امضای JWT برای session (مهم: در production حتماً عوض کنید!)
SESSION_SECRET="hotel-facility-management-secret-key-change-in-production-2024"
